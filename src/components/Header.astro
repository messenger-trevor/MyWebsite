---
import { site } from "../data/site";

const links = [
  { href: "#about", label: "About Me" },
  { href: "#work", label: "My Work" },
  { href: "#contact", label: "Contact" },
];
---

<header class="site-header" data-open="false">
  <nav aria-label="Primary">
    <a class="logo" href="#top">{site.logoFirst}<span>{site.logoSecond}</span></a>
    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-menu"
      aria-label="Toggle menu"
    >
      <span></span><span></span><span></span>
    </button>
    <ul id="primary-menu">
      {links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
    </ul>
  </nav>
  <div class="progress" aria-hidden="true"></div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: white;
    border-bottom: 0.1rem solid var(--teal);
  }
  nav {
    height: var(--nav-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 5%;
  }
  .logo {
    font-style: italic;
    font-weight: 500;
    font-size: clamp(1.2rem, 4.5vw, 2rem);
    color: var(--teal);
    text-decoration: none;
    white-space: nowrap;
  }
  .logo span {
    color: var(--orange-text);
  }
  ul {
    display: flex;
    gap: 2.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  ul a {
    position: relative;
    font-size: 1.2rem;
    color: var(--teal);
    text-decoration: none;
    white-space: nowrap;
  }
  ul a::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -2px;
    width: 100%;
    height: 2px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 250ms;
  }
  ul a:hover::after,
  ul a:focus-visible::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  .menu-toggle {
    display: none;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0.7rem;
    border: 0;
    background: transparent;
    cursor: pointer;
    flex-direction: column;
    justify-content: space-between;
  }
  .menu-toggle span {
    display: block;
    height: 2px;
    background: var(--teal);
    transition:
      transform 0.25s,
      opacity 0.25s;
  }
  .site-header[data-open="true"] .menu-toggle span:nth-child(1) {
    transform: translateY(0.6rem) rotate(45deg);
  }
  .site-header[data-open="true"] .menu-toggle span:nth-child(2) {
    opacity: 0;
  }
  .site-header[data-open="true"] .menu-toggle span:nth-child(3) {
    transform: translateY(-0.6rem) rotate(-45deg);
  }

  .progress {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    height: 6px;
    background: var(--teal);
    transform-origin: 0 50%;
    transform: scaleX(var(--p, 0));
    pointer-events: none;
  }

  @media (max-width: 774px) {
    .menu-toggle {
      display: flex;
    }
    ul {
      position: fixed;
      top: var(--nav-h);
      right: 0;
      bottom: 0;
      width: min(80vw, 20rem);
      flex-direction: column;
      justify-content: center;
      align-items: flex-end;
      gap: 2rem;
      padding: 2rem;
      background: white;
      border-left: 0.1rem solid var(--teal);
      transform: translateX(100%);
      visibility: hidden;
      transition:
        transform 0.3s ease-in-out,
        visibility 0.3s;
    }
    ul a {
      font-size: 1.8rem;
    }
    .site-header[data-open="true"] ul {
      transform: none;
      visibility: visible;
    }
    ul {
      z-index: 2;
    }
    /* dim backdrop behind the open menu; clicking it closes the menu */
    .site-header[data-open="true"]::after {
      content: "";
      position: fixed;
      inset: var(--nav-h) 0 0 0;
      z-index: 1;
      background: rgba(0, 0, 0, 0.35);
    }
  }

  /* No JS: show the links inline instead of a menu that can't open. */
  :global(html:not(.js)) .menu-toggle {
    display: none;
  }
  @media (max-width: 774px) {
    :global(html:not(.js)) ul {
      position: static;
      flex-direction: row;
      width: auto;
      padding: 0;
      border: 0;
      gap: 1rem;
      transform: none;
      visibility: visible;
    }
    :global(html:not(.js)) ul a {
      font-size: 1rem;
    }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>(".site-header")!;
  const toggle = header.querySelector<HTMLButtonElement>(".menu-toggle")!;
  const menu = header.querySelector<HTMLElement>("#primary-menu")!;

  function setOpen(open: boolean) {
    header.dataset.open = String(open);
    toggle.setAttribute("aria-expanded", String(open));
  }
  toggle.addEventListener("click", () => setOpen(header.dataset.open !== "true"));
  header.addEventListener("click", (e) => {
    if (e.target === header) setOpen(false); // the backdrop
  });
  menu.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setOpen(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") setOpen(false);
  });

  // Scroll progress bar (was a Framer Motion useScroll/useSpring).
  let ticking = false;
  function updateProgress() {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    const p = max > 0 ? Math.min(1, window.scrollY / max) : 0;
    header.style.setProperty("--p", String(p));
    ticking = false;
  }
  addEventListener(
    "scroll",
    () => {
      if (!ticking) {
        ticking = true;
        requestAnimationFrame(updateProgress);
      }
    },
    { passive: true },
  );
  updateProgress();
</script>
