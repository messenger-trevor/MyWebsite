---
import { site } from "../data/site";

// Set these in .env (see .env.example). Without an endpoint no form is rendered.
const endpoint = import.meta.env.PUBLIC_FORM_ENDPOINT;
const accessKey = import.meta.env.PUBLIC_FORM_ACCESS_KEY;
---

<section id="contact" class="contact">
  <h2 class="section-title">Contact</h2>
  {
    endpoint ? (
      <form method="POST" action={endpoint}>
        {accessKey && <input type="hidden" name="access_key" value={accessKey} />}
        {/* Honeypot: hidden from people, bots fill it in. Field name varies by service. */}
        <input type="text" name="_gotcha" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
        <label>
          Name
          <input type="text" name="name" required autocomplete="name" />
        </label>
        <label>
          Email
          <input type="email" name="email" required autocomplete="email" />
        </label>
        <label>
          Message
          <textarea name="message" rows="6" required></textarea>
        </label>
        <button type="submit">Send</button>
      </form>
    ) : (
      <p class="notice">The contact form isn't set up yet. In the meantime, you can reach me on <a href={site.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>.</p>
    )
  }
</section>

<style>
  .contact {
    border-top: 0.1rem solid var(--teal);
    padding: clamp(2rem, 7vw, 6rem) clamp(1rem, 7vw, 6rem) 3rem;
    text-align: center;
  }
  form {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 32rem;
    margin: 0 auto;
    text-align: left;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--teal);
  }
  input[type="text"],
  input[type="email"],
  textarea {
    padding: 0.7rem;
    font: inherit;
    border: 1px solid var(--teal);
    border-radius: 4px;
    background: white;
  }
  button {
    align-self: flex-start;
    padding: 0.7rem 1.6rem;
    font: inherit;
    color: white;
    background: var(--teal);
    border: 0;
    border-radius: 4px;
    cursor: pointer;
  }
  button:hover {
    background: #075a60;
  }
  .hp {
    position: absolute;
    left: -9999px;
  }
  .notice {
    max-width: 32rem;
    margin: 0 auto;
    font-size: 1.1rem;
    line-height: 1.6;
  }
</style>
